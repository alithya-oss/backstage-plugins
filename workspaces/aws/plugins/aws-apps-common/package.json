{
  "name": "@alithya-oss/backstage-plugin-aws-apps-common",
  "description": "Common functionalities for the aws-apps plugin",
  "version": "0.4.7",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "author": {
    "name": "Amazon Web Services",
    "url": "https://aws.amazon.com"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alithya-oss/backstage-plugins.git",
    "directory": "workspaces/aws/plugins/aws-apps-common"
  },
  "bugs": {
    "url": "https://github.com/alithya-oss/backstage-plugins/issues"
  },
  "backstage": {
    "role": "common-library",
    "pluginId": "aws-apps-common",
    "pluginPackages": [
      "@alithya-oss/backstage-plugin-aws-apps-common"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "tsc": "tsc",
    "tsc-config": "tsc --showConfig",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --all --watchAll=false",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "typescript": "~5.8.0"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1019.0",
    "@aws-sdk/types": "^3.973.6",
    "@backstage/catalog-model": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@backstage/types": "backstage:^"
  }
}
