{
  "name": "@internal/aws",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "dev": "dotenv -- concurrently \"docker compose up\" \"backstage-cli repo start\"",
    "start": "backstage-cli repo start",
    "start-backend": "yarn workspace backend start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build:api-reports": "yarn build:api-reports:only --tsc",
    "build:api-reports:only": "backstage-repo-tools api-reports -o ae-wrong-input-file-type,ae-undocumented,ae-forgotten-export --validate-release-tags",
    "build:knip-reports": "backstage-repo-tools knip-reports",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new --scope @alithya-oss",
    "postinstall": "cd ../../ && yarn install"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alithya-oss/backstage-plugins",
    "directory": "workspaces/aws"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/cli-defaults": "backstage:^",
    "@backstage/e2e-test-utils": "backstage:^",
    "@backstage/repo-tools": "backstage:^",
    "@changesets/cli": "^2.27.1",
    "@playwright/test": "^1.32.3",
    "@useoptic/optic": "~0.50.7",
    "concurrently": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "knip": "^5.27.4",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@protobufjs/inquire": "1.1.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mui/styles": "^6.1.2"
  }
}
